# Browser-facing market configuration.
VITE_MARKET_BRAND=zenmind
VITE_MARKET_API_BASE=/market/api/v1
VITE_BASE_PATH=/market/

# Vite development server.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_DEV_STRICT_PORT=true

# Development reverse proxies. NPM and artifact targets fall back to the API target.
MARKET_API_PROXY_TARGET=http://127.0.0.1:8088
MARKET_NPM_PROXY_TARGET=http://127.0.0.1:8088
MARKET_ARTIFACT_PROXY_TARGET=http://127.0.0.1:8088

# Optional trusted-proxy identity for local development without OIDC.
# Keep these variables unprefixed: they are Vite server settings and must not be
# exposed to browser code. MARKET_DEV_PROXY_TOKEN must equal the Market Server's
# MARKET_PROXY_TOKEN.
MARKET_DEV_PROXY_TOKEN=local-dev
MARKET_DEV_USER_ID=local-admin
MARKET_DEV_USER_ROLE=admin
