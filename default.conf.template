server {
  listen 80;
  server_name _;
  client_max_body_size 512m;

  root /usr/share/nginx/html;
  index index.html;

  # Redirect /market → /market/ so relative asset URLs (./assets/...) resolve
  # correctly in the browser. When NGINX_BASE_PATH is empty this never matches
  # ($uri is always at least "/").
  if ($uri = "${NGINX_BASE_PATH}") {
    return 301 ${NGINX_BASE_PATH}/;
  }

  # proxy_pass never includes the prefix — the backend serves at /api/, /npm/,
  # /artifacts/ regardless of where the frontend is mounted.
  location ${NGINX_BASE_PATH}/api/ {
    proxy_pass http://${NGINX_BACKEND_HOST}:${NGINX_BACKEND_PORT}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ${NGINX_BASE_PATH}/npm/ {
    proxy_pass http://${NGINX_BACKEND_HOST}:${NGINX_BACKEND_PORT}/npm/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ${NGINX_BASE_PATH}/artifacts/ {
    proxy_pass http://${NGINX_BACKEND_HOST}:${NGINX_BACKEND_PORT}/artifacts/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Catch-all: static files are at /usr/share/nginx/html/ (no sub-directory).
  # The symlink created by 40-create-base-path.sh maps e.g. html/market/ → html/
  # so root-based file lookup works for any sub-path.
  location ${NGINX_BASE_PATH}/ {
    try_files $uri $uri/ ${NGINX_BASE_PATH}/index.html;
  }
}
